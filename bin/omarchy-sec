#!/bin/bash

# ==============================================================================
# Omarchy Sec - Unified Security & EDR CLI
# ==============================================================================

set -euo pipefail

# Los subcomandos delegan en binarios hermanos. El paquete los instala planos en
# /usr/bin y en un checkout conviven en bin/: resolverlos por ruta hace que
# ambos casos funcionen. Antes se invocaban a secas y desde el checkout fallaban
# con "command not found" salvo que /usr/bin ya tuviera el paquete instalado.
SELF_DIR="$(dirname "$(readlink -f "$0")")"

cmd="${1:-status}"
shift || true

case "$cmd" in
status)
  "$SELF_DIR/omarchy-sec-detect"
  ;;
agent|"call-agent"|incident)
  "$SELF_DIR/omarchy-sec-agent" "$@"
  ;;
onboard|enroll)
  "$SELF_DIR/omarchy-sec-onboard" "$@"
  ;;
api)
  "$SELF_DIR/omarchy-sec-wazuh-api" "$@"
  ;;
dashboard|soc)
  xdg-open "https://localhost:9001" 2>/dev/null || echo "Abre https://localhost:9001 en tu navegador."
  ;;
test)
  repo_tests="$(dirname "$(readlink -f "$0")")/../tests/run_tests.sh"
  if [ -x "$repo_tests" ]; then
    "$repo_tests"
  else
    echo "omarchy-sec: 'test' solo corre desde un checkout del repositorio." >&2
    echo "  git clone https://github.com/MAXI8594/omarchy-sec.git && cd omarchy-sec && ./tests/run_tests.sh" >&2
    exit 78
  fi
  ;;
setup)
  # setup.sh y tests/ viven en el checkout del repo, no en el paquete: instalado
  # en /usr/bin esto resolvia a /usr/setup.sh. Se busca el checkout o se explica.
  repo_setup="$(dirname "$(readlink -f "$0")")/../setup.sh"
  if [ -x "$repo_setup" ]; then
    "$repo_setup"
  else
    echo "omarchy-sec: 'setup' solo corre desde un checkout del repositorio." >&2
    echo "  git clone https://github.com/MAXI8594/omarchy-sec.git && cd omarchy-sec && ./setup.sh" >&2
    exit 78
  fi
  ;;
help|--help|-h)
  echo "Uso: omarchy-sec <comando>"
  echo ""
  echo "Comandos:"
  echo "  status         Muestra el estado de protección y sensores EDR (JSON)"
  echo "  agent          Llama al Agente de Seguridad con acceso a la API de Wazuh"
  echo "  onboard        Asistente de onboarding corporativo (Falcon, MDE, S1, Cortex)"
  echo "  api <cmd>      Consulta directa a la API de Wazuh (summary, alerts, sca, fim)"
  echo "  dashboard      Abre la consola web del SOC (:9001)"
  echo "  setup          Inicia el asistente interactivo de instalación"
  echo "  test           Ejecuta el pipeline de pruebas DevSecOps (SAST, IaC, Secrets)"
  ;;
*)
  echo "Comando desconocido: $cmd. Ejecuta 'omarchy-sec help' para ver la ayuda."
  exit 1
  ;;
esac
