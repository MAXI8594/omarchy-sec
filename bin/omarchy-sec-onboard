#!/bin/bash

# ==============================================================================
# Omarchy Sec - Enterprise EDR/XDR/MDR Onboarding & Diagnostics Wizard
# ==============================================================================

set -euo pipefail

vendor="${1:-}"

show_menu() {
  echo -e "\e[1;36m======================================================================\e[0m"
  echo -e "\e[1;36m 🏢  OMARCHY SEC: ASISTENTE DE ONBOARDING CORPORATIVO EDR / XDR       \e[0m"
  echo -e "\e[1;36m======================================================================\e[0m"
  echo ""
  echo "Selecciona el agente corporativo que deseas integrar en Omarchy:"
  echo "  1) CrowdStrike Falcon Sensor (falcon-sensor)"
  echo "  2) Microsoft Defender for Endpoint (mdatp)"
  echo "  3) SentinelOne Singularity Linux Agent (sentinelone)"
  echo "  4) Palo Alto Networks Cortex XDR (cortex-agent / traps)"
  echo "  5) Wazuh Agent (Open Source / Managed MDR)"
  echo "  6) Salir"
  echo ""
  read -p "Opción [1-6]: " -r opt
  case "$opt" in
    1) onboard_falcon ;;
    2) onboard_defender ;;
    3) onboard_sentinelone ;;
    4) onboard_cortex ;;
    5) onboard_wazuh ;;
    *) echo "Operación cancelada."; exit 0 ;;
  esac
}

onboard_falcon() {
  echo -e "\n\e[1;33m[🦅 CrowdStrike Falcon Sensor - Onboarding]\e[0m"
  echo "1. Si tienes el archivo .rpm de tu empresa, extráelo con:"
  echo "   sudo rpmextract.sh falcon-sensor-*.rpm"
  echo ""
  read -p "Ingresa el Customer ID (CID) provisto por tu empresa (o deja en blanco): " -r cid
  if [ -n "$cid" ]; then
    sudo /opt/CrowdStrike/falconctl -s -f --cid="$cid" || true
    sudo /opt/CrowdStrike/falconctl -s --rfm-state=false || true
    sudo systemctl enable --now falcon-sensor 2>/dev/null || true
    echo -e "\n\e[1;32m✓ Falcon Sensor configurado. Verificando estado:\e[0m"
    sudo /opt/CrowdStrike/falconctl -g --cid --rfm-state --version 2>/dev/null || true
  fi
}

onboard_defender() {
  echo -e "\n\e[1;33m[🛡️ Microsoft Defender for Endpoint (MDE) - Onboarding]\e[0m"
  echo "1. Si tienes el paquete .deb, conviértelo e instálalo con:"
  echo "   debtap mdatp_*.deb && sudo pacman -U mdatp-*.pkg.tar.zst"
  echo ""
  echo "2. Para enrolar con el tenant de tu empresa, ejecuta:"
  echo "   sudo python3 MicrosoftDefenderATPOnboardingLinuxClient.py"
  echo ""
  if command -v mdatp >/dev/null 2>&1; then
    echo -e "\e[1;32mVerificando estado de Defender en este equipo:\e[0m"
    mdatp health 2>/dev/null || true
  fi
}

onboard_sentinelone() {
  echo -e "\n\e[1;33m[🟣 SentinelOne Singularity - Onboarding]\e[0m"
  echo "1. Si tienes el paquete .rpm, extráelo con:"
  echo "   sudo rpmextract.sh SentinelAgent-*.rpm"
  echo ""
  read -p "Ingresa el Site Token provisto por tu empresa (o deja en blanco): " -r token
  if [ -n "$token" ]; then
    sudo /opt/sentinelone/bin/sentinelctl control site-token set "$token" || true
    sudo systemctl enable --now sentinelone 2>/dev/null || true
    echo -e "\n\e[1;32m✓ SentinelOne configurado. Verificando estado:\e[0m"
    sudo /opt/sentinelone/bin/sentinelctl status 2>/dev/null || true
  fi
}

onboard_cortex() {
  echo -e "\n\e[1;33m[🔷 Palo Alto Cortex XDR - Onboarding]\e[0m"
  echo "1. Ejecuta el script instalador de tu empresa con su Distribution Token:"
  echo "   sudo ./cortex-installer.sh --distribution-token=\"<TOKEN>\""
  echo ""
  if [ -f "/opt/traps/bin/cytool" ]; then
    echo -e "\e[1;32mVerificando estado de Cortex XDR:\e[0m"
    sudo /opt/traps/bin/cytool check 2>/dev/null || true
  fi
}

onboard_wazuh() {
  echo -e "\n\e[1;33m[🐺 Wazuh Agent - Onboarding]\e[0m"
  read -p "Ingresa la IP o FQDN del Wazuh Manager central: " -r manager_ip
  read -p "Ingresa el Password de registro (o deja en blanco si no tiene): " -r pass
  
  if [ -n "$manager_ip" ]; then
    pass_arg=""
    [ -n "$pass" ] && pass_arg="-P $pass"
    # shellcheck disable=SC2086
    sudo /var/ossec/bin/agent-auth -m "$manager_ip" $pass_arg -A "$(hostname)" || true
    sudo sed -i "s/<address>.*<\/address>/<address>$manager_ip<\/address>/" /var/ossec/etc/ossec.conf || true
    sudo systemctl enable --now wazuh-agent 2>/dev/null || true
    echo -e "\n\e[1;32m✓ Wazuh Agent registrado y conectado.\e[0m"
  fi
}

case "$vendor" in
  falcon|crowdstrike) onboard_falcon ;;
  defender|mde|mdatp) onboard_defender ;;
  sentinelone|s1)     onboard_sentinelone ;;
  cortex|traps)       onboard_cortex ;;
  wazuh)              onboard_wazuh ;;
  "")                 show_menu ;;
  *) echo "Sensor desconocido: $vendor. Opciones: falcon, defender, sentinelone, cortex, wazuh"; exit 1 ;;
esac
