#!/bin/bash

# ==============================================================================
# Omarchy Sec - Wazuh Live REST API & Telemetry Query Client
# ==============================================================================

set -euo pipefail

API_URL="${WAZUH_API_URL:-https://localhost:55000}"
API_USER="${WAZUH_API_USER:-wazuh-wui}"
API_PASS="${WAZUH_API_PASS:-MyS3cr37P450r.*-}"
CONTAINER_NAME="single-node-wazuh.manager-1"
TOKEN_CACHE="/tmp/.wazuh_api_token"

get_token() {
  if [ -f "$TOKEN_CACHE" ]; then
    # Check if cached token is less than 10 minutes old
    local cache_age
    cache_age=$(($(date +%s) - $(stat -c %Y "$TOKEN_CACHE" 2>/dev/null || echo 0)))
    if [ "$cache_age" -lt 600 ]; then
      cat "$TOKEN_CACHE"
      return 0
    fi
  fi

  local auth_response
  auth_response=$(curl -k -s -u "${API_USER}:${API_PASS}" -X POST "${API_URL}/security/user/authenticate" 2>/dev/null || true)
  
  local token
  token=$(echo "$auth_response" | jq -r '.data.token // empty' 2>/dev/null || true)
  
  if [ -n "$token" ]; then
    echo "$token" > "$TOKEN_CACHE"
    chmod 600 "$TOKEN_CACHE"
    echo "$token"
  else
    return 1
  fi
}

api_req() {
  local endpoint="$1"
  local token
  token=$(get_token) || {
    echo "{\"error\": 1, \"message\": \"No se pudo autenticar con la API de Wazuh en $API_URL\"}"
    return 1
  }
  local res
  res=$(curl -k -s -H "Authorization: Bearer $token" -X GET "${API_URL}${endpoint}" 2>/dev/null || true)
  echo "$res"
}

subcmd="${1:-summary}"
shift || true

case "$subcmd" in
token)
  get_token
  ;;
agents)
  raw_agents=$(api_req "/agents")
  echo "$raw_agents" | jq .
  ;;
status|manager)
  raw_status=$(api_req "/manager/status")
  echo "$raw_status" | jq .
  ;;
sca)
  agent_id="${1:-001}"
  raw_sca=$(api_req "/sca/${agent_id}")
  echo "$raw_sca" | jq .
  ;;
syscheck|fim)
  agent_id="${1:-001}"
  raw_fim=$(api_req "/syscheck/${agent_id}")
  echo "$raw_fim" | jq .
  ;;
alerts)
  limit="${1:-10}"
  min_level="${2:-0}"
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "$CONTAINER_NAME"; then
    raw_alerts=$(docker exec -i "$CONTAINER_NAME" tail -n 100 /var/ossec/logs/alerts/alerts.json 2>/dev/null || echo "")
    echo "$raw_alerts" | jq -s --argjson min "$min_level" --argjson lim "$limit" \
      'map(select((.rule.level // 0) >= $min)) | reverse | .[:$lim]'
  else
    echo "[]"
  fi
  ;;
summary)
  agents_json=$(api_req "/agents" 2>/dev/null || echo "{}")
  recent_alerts="[]"
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "$CONTAINER_NAME"; then
    raw_tail=$(docker exec -i "$CONTAINER_NAME" tail -n 50 /var/ossec/logs/alerts/alerts.json 2>/dev/null || echo "")
    recent_alerts=$(echo "$raw_tail" | jq -s 'reverse | .[:5] | map({level: .rule.level, description: .rule.description, id: .rule.id, timestamp: .timestamp, file: .syscheck.path})' 2>/dev/null || echo "[]")
  fi

  cat <<JSON_SUM
{
  "timestamp": "$(date -Iseconds)",
  "apiConnected": $([ "$(echo "$agents_json" | jq -r '.error // 1')" == "0" ] && echo "true" || echo "false"),
  "agents": $(echo "$agents_json" | jq '.data.affected_items // []'),
  "recentAlerts": $recent_alerts
}
JSON_SUM
  ;;
query)
  endpoint="${1:?Debe especificar el endpoint, ej: /agents}"
  raw_q=$(api_req "$endpoint")
  echo "$raw_q" | jq .
  ;;
help|--help|-h)
  echo "Uso: omarchy-sec-wazuh-api <comando>"
  echo "  summary            Resumen general del estado de agentes y últimas alertas"
  echo "  alerts [lim] [min] Últimas alertas de alerts.json (opcional: límite y severidad mínima)"
  echo "  agents             Lista todos los agentes registrados en el SOC"
  echo "  sca [agent_id]     Evaluaciones de configuración de seguridad (SCA)"
  echo "  fim [agent_id]     Cambios en integridad de archivos (FIM Syscheck)"
  echo "  status             Estado de los demonios internos del Wazuh Manager"
  echo "  query <endpoint>   Consulta directa a cualquier endpoint de la API REST"
  ;;
*)
  echo "Comando no reconocido: $subcmd"
  exit 1
  ;;
esac
