#!/bin/bash

# ==============================================================================
# Omarchy Sec - Wazuh Live REST API & Telemetry Query Client
# ==============================================================================

set -euo pipefail

# Las credenciales las genera setup.sh al azar; no hay default que valga.
# Orden: variables de entorno > archivo de config del usuario.
CONFIG_FILE="${OMARCHY_SEC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-sec/env}"
if [ -r "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  . "$CONFIG_FILE"
fi

API_URL="${WAZUH_API_URL:-https://localhost:55000}"
API_USER="${WAZUH_API_USER:-wazuh-wui}"
API_PASS="${WAZUH_API_PASS:-}"
CONTAINER_NAME="${WAZUH_CONTAINER_NAME:-single-node-wazuh.manager-1}"

if [ -z "$API_PASS" ]; then
  echo "omarchy-sec: falta la password de la API de Wazuh." >&2
  echo "  Corré ./setup.sh (la genera y la guarda en $CONFIG_FILE)," >&2
  echo "  o exportá WAZUH_API_PASS antes de invocar este comando." >&2
  exit 78  # EX_CONFIG
fi

# El token de sesión NO va a /tmp: es un directorio compartido y la ruta era
# predecible, así que cualquier usuario local podía plantar el archivo antes y
# hacer que lo usáramos como token, o leer el nuestro. XDG_RUNTIME_DIR es
# privado del usuario (0700) y se limpia al cerrar sesión.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-sec"
if ! mkdir -p "$RUNTIME_DIR"; then
  # Con `mkdir ... && chmod ...` un fallo aca no cortaba (bash exime las listas
  # AND-OR de errexit) y se seguia con un directorio inexistente.
  echo "omarchy-sec: no se pudo crear $RUNTIME_DIR para el cache del token." >&2
  exit 73  # EX_CANTCREAT
fi
chmod 700 "$RUNTIME_DIR"
TOKEN_CACHE="$RUNTIME_DIR/wazuh_api_token"

# Las credenciales y el token NO van en argv: `ps` los muestra a cualquier
# usuario local mientras dura el request. curl los lee de stdin con --config -.
cfg_quote() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

get_token() {
  if [ -f "$TOKEN_CACHE" ]; then
    # Check if cached token is less than 10 minutes old
    local cache_age cached
    cache_age=$(($(date +%s) - $(stat -c %Y "$TOKEN_CACHE" 2>/dev/null || echo 0)))
    if [ "$cache_age" -lt 600 ]; then
      cached=$(cat "$TOKEN_CACHE")
      # Un cache vacio devolvia un "Bearer " vacio: todos los requests fallaban
      # con 401 durante 10 minutos y nada lo explicaba. Si esta vacio, reautentica.
      if [ -n "$cached" ]; then
        printf '%s\n' "$cached"
        return 0
      fi
    fi
  fi

  local auth_response rc=0
  auth_response=$(printf 'user = "%s:%s"\n' "$(cfg_quote "$API_USER")" "$(cfg_quote "$API_PASS")" \
    | curl -k -s --config - -X POST "${API_URL}/security/user/authenticate") || rc=$?

  if [ "$rc" -ne 0 ]; then
    echo "omarchy-sec: no hubo respuesta de $API_URL al autenticar (curl salio $rc)." >&2
    return 1
  fi

  local token
  token=$(printf '%s' "$auth_response" | jq -r '.data.token // empty' 2>/dev/null || true)

  if [ -z "$token" ]; then
    # El motivo real (credenciales invalidas, usuario bloqueado) viene en el
    # cuerpo de la respuesta; tragarlo dejaba al usuario sin nada que mirar.
    echo "omarchy-sec: la API rechazo la autenticacion. Respuesta:" >&2
    printf '%s\n' "$auth_response" | head -c 500 >&2
    echo >&2
    return 1
  fi

  (umask 077; printf '%s\n' "$token" > "$TOKEN_CACHE")
  chmod 600 "$TOKEN_CACHE"
  printf '%s\n' "$token"
}

# Siempre imprime JSON valido, incluso al fallar: quien consume esta salida
# (summary, el agente) hacia jq sobre ella y con una respuesta vacia terminaba
# generando JSON roto.
api_error() {
  jq -cn --arg msg "$1" '{error: 1, message: $msg}'
}

api_req() {
  local endpoint="$1"
  local token res rc=0
  if ! token=$(get_token); then
    api_error "No se pudo autenticar con la API de Wazuh en $API_URL"
    return 1
  fi

  res=$(printf 'header = "Authorization: Bearer %s"\n' "$(cfg_quote "$token")" \
    | curl -k -s --config - -X GET "${API_URL}${endpoint}") || rc=$?

  # Antes esto era `|| true` + echo: con la API caida devolvia la cadena vacia
  # y el llamador no tenia forma de distinguirlo de una respuesta legitima.
  if [ "$rc" -ne 0 ] || [ -z "$res" ]; then
    api_error "Sin respuesta de la API de Wazuh en ${API_URL}${endpoint} (curl salio $rc)"
    return 1
  fi

  printf '%s\n' "$res"
}

# Imprime la respuesta formateada y propaga el fallo al exit code. Antes cada
# subcomando hacia `raw=$(api_req ...)`, que bajo `set -e` mataba el script sin
# imprimir absolutamente nada cuando la API no respondia.
api_show() {
  local out rc=0
  out=$(api_req "$1") || rc=$?
  printf '%s\n' "$out" | jq .
  return "$rc"
}

# Ultimas N alertas del manager. Devolver "[]" cuando Docker no responde era
# indistinguible de "no hay alertas": la peor mentira posible en un EDR.
alerts_tail() {
  local n="$1" running
  if ! running=$(docker ps --format '{{.Names}}'); then
    echo "omarchy-sec: no se pudo consultar Docker (daemon caido o sin permiso sobre el socket)." >&2
    return 1
  fi
  if ! grep -qxF "$CONTAINER_NAME" <<<"$running"; then
    echo "omarchy-sec: el contenedor $CONTAINER_NAME no esta corriendo." >&2
    return 1
  fi
  docker exec -i "$CONTAINER_NAME" tail -n "$n" /var/ossec/logs/alerts/alerts.json
}

require_uint() {
  case "$2" in
    ''|*[!0-9]*)
      echo "omarchy-sec: '$1' debe ser un entero no negativo (recibido: '$2')." >&2
      exit 64  # EX_USAGE
      ;;
  esac
}

subcmd="${1:-summary}"
shift || true

case "$subcmd" in
token)
  get_token
  ;;
agents)
  api_show "/agents"
  ;;
status|manager)
  api_show "/manager/status"
  ;;
sca)
  agent_id="${1:-001}"
  api_show "/sca/${agent_id}"
  ;;
syscheck|fim)
  agent_id="${1:-001}"
  api_show "/syscheck/${agent_id}"
  ;;
alerts)
  limit="${1:-10}"
  min_level="${2:-0}"
  # Ambos van directo al parser de jq via --argjson: se validan antes.
  require_uint "limite" "$limit"
  require_uint "nivel_min" "$min_level"

  raw_alerts=$(alerts_tail 100) || exit 1
  printf '%s\n' "$raw_alerts" | jq -s --argjson min "$min_level" --argjson lim "$limit" \
    'map(select((.rule.level // 0) >= $min)) | reverse | .[:$lim]'
  ;;
summary)
  # api_req ya devuelve JSON valido al fallar; antes el `|| echo "{}"` sumaba un
  # segundo documento a la salida de error y el jq de abajo emitia dos valores,
  # dejando este bloque con JSON invalido ("agents": []\n[]).
  agents_json=$(api_req "/agents") || true

  recent_alerts="[]"
  if raw_tail=$(alerts_tail 50); then
    recent_alerts=$(printf '%s\n' "$raw_tail" | jq -s 'reverse | .[:5] | map({level: .rule.level, description: .rule.description, id: .rule.id, timestamp: .timestamp, file: .syscheck.path})' 2>/dev/null || echo "[]")
    [ -n "$recent_alerts" ] || recent_alerts="[]"
  fi

  cat <<JSON_SUM
{
  "timestamp": "$(date -Iseconds)",
  "apiConnected": $([ "$(echo "$agents_json" | jq -r '.error // 1')" == "0" ] && echo "true" || echo "false"),
  "agents": $(echo "$agents_json" | jq '.data.affected_items // []'),
  "recentAlerts": $recent_alerts
}
JSON_SUM
  ;;
query)
  endpoint="${1:?Debe especificar el endpoint, ej: /agents}"
  api_show "$endpoint"
  ;;
help|--help|-h)
  echo "Uso: omarchy-sec-wazuh-api <comando>"
  echo "  summary            Resumen general del estado de agentes y últimas alertas"
  echo "  alerts [lim] [min] Últimas alertas de alerts.json (opcional: límite y severidad mínima)"
  echo "  agents             Lista todos los agentes registrados en el SOC"
  echo "  sca [agent_id]     Evaluaciones de configuración de seguridad (SCA)"
  echo "  fim [agent_id]     Cambios en integridad de archivos (FIM Syscheck)"
  echo "  status             Estado de los demonios internos del Wazuh Manager"
  echo "  query <endpoint>   Consulta directa a cualquier endpoint de la API REST"
  ;;
*)
  echo "Comando no reconocido: $subcmd"
  exit 1
  ;;
esac
