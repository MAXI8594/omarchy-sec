# Copy this file to .env and fill in random values, or just run ./setup.sh
# from the repo root — it generates .env with random passwords on first run
# and regenerates the matching bcrypt hashes in
# config/wazuh_indexer/internal_users.yml automatically.
#
# INDEXER_PASSWORD and DASHBOARD_PASSWORD MUST match the bcrypt hashes stored
# for the "admin" and "kibanaserver" users in
# config/wazuh_indexer/internal_users.yml (generated with the indexer image's
# own plugins/opensearch-security/tools/hash.sh). If you change these by hand,
# regenerate those hashes too — see docker/single-node/README.md.

INDEXER_PASSWORD=
API_PASSWORD=
DASHBOARD_PASSWORD=
